{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Startup failure record",
  "type":"object",
  "required":["id","name","failure_classification","verification_status","sources"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "name":{"type":"string","minLength":1},
    "aliases":{"type":"array","items":{"type":"string"}},
    "description":{"type":["string","null"]},
    "industry":{"type":["string","null"]},
    "founded_date":{"type":["string","null"],"format":"date"},
    "founded_year":{"type":["integer","null"],"minimum":1800,"maximum":2026},
    "failure_event_date":{"type":["string","null"],"format":"date"},
    "failure_classification":{"enum":["formal_bankruptcy","insolvency","liquidation","shutdown","distressed_acquisition","restructuring","product_discontinuation","business_collapse","unknown"]},
    "founders":{"type":"array","items":{"type":"string"}},
    "locations":{"type":"array","items":{"$ref":"#/$defs/location"}},
    "failure_summary":{"type":["string","null"]},
    "failure_causes":{"type":"array","items":{"type":"string"}},
    "verification_status":{"enum":["unverified","needs_review","partially_verified","verified"]},
    "sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}}
  },
  "$defs":{
    "location":{
      "type":"object",
      "required":["location_type","precision"],
      "properties":{
        "location_type":{"enum":["founding_office","original_operating_location","historical_headquarters","final_headquarters","registered_office","city_reference"]},
        "address":{"type":["string","null"]},
        "neighbourhood":{"type":["string","null"]},
        "city":{"type":["string","null"]},
        "region":{"type":["string","null"]},
        "country":{"type":["string","null"]},
        "latitude":{"type":["number","null"],"minimum":-90,"maximum":90},
        "longitude":{"type":["number","null"],"minimum":-180,"maximum":180},
        "precision":{"enum":["exact_address","neighbourhood","city_approximate","country_only","unknown"]},
        "coordinate_source_url":{"type":["string","null"],"format":"uri"}
      }
    },
    "source":{
      "type":"object",
      "required":["url","source_type"],
      "properties":{
        "url":{"type":"string","format":"uri"},
        "title":{"type":["string","null"]},
        "publisher":{"type":["string","null"]},
        "publication_date":{"type":["string","null"],"format":"date"},
        "source_type":{"enum":["official_filing","company_announcement","court_record","news_report","directory","interview","other"]},
        "supports":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}